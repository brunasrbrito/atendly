# .env de PRODUÇÃO para o alwaysdata.
# O 'deploy/server.sh install' cria o ~/atendly/.env a partir deste modelo sozinho:
# troca [conta] pelo nome da conta, pergunta a senha do banco e gera chave, token e senha demo.

APP_NAME=Atendly
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://[conta].alwaysdata.net
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Banco: Databases > MySQL no painel. [conta] é trocado automaticamente pelo script de instalação;
# a senha é perguntada no terminal. Se você deu outro nome ao banco, ajuste DB_DATABASE.
DB_CONNECTION=mysql
DB_HOST=mysql-[conta].alwaysdata.net
DB_PORT=3306
DB_DATABASE=[conta]_db
DB_USERNAME=[conta]
DB_PASSWORD=[senha-do-banco]

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# E-mail ("esqueci a senha"). "log" grava o e-mail em storage/logs/laravel.log.
# Para envio real: crie um endereço em Emails > Addresses no painel, troque MAIL_MAILER
# para smtp e descomente/preencha as linhas abaixo.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="suporte@[conta].alwaysdata.net"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_HOST=smtp-[conta].alwaysdata.net
# MAIL_PORT=587
# MAIL_USERNAME=endereco@exemplo.com
# MAIL_PASSWORD=senha-do-email

VITE_APP_NAME="${APP_NAME}"

# Atendly
# Gere um token longo e aleatório (o script de instalação já gera um).
ATENDLY_INTEGRATION_TOKEN=
ATENDLY_POLL_SECONDS=15
ATENDLY_ACK_ALERT_MINUTES=15
ATENDLY_SHOW_TEST_MARKS=false
ATENDLY_BLOCK_NON_BUSINESS_DAYS=true
ATENDLY_HOLIDAYS_API=https://brasilapi.com.br/api/feriados/v1
# Senha das contas de demonstração (admin@ e tecnico1..4@atendly.test). Use uma senha forte:
# a URL é pública. O script de instalação gera uma e mostra ao final.
ATENDLY_DEMO_PASSWORD=
